NEXT_PUBLIC_APP_URL=https://acme.com

# https://github.com/settings/tokens
GITHUB_API_TOKEN=

# https://github.com/grubersjoe/github-contributions-api
GITHUB_CONTRIBUTIONS_API_URL=https://github-contributions-api.jogruber.de

# https://www.dmca.com/ProtectionPro.aspx
NEXT_PUBLIC_DMCA_URL=https://www.dmca.com

# Search Console > add a URL-prefix property > "HTML tag" method.
# Paste only the content value, not the whole <meta> tag. No DNS change needed.
GOOGLE_SITE_VERIFICATION=

# https://us.posthog.com/project/:id/settings/project
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
# Leave blank for PostHog Cloud US; set only for a self-hosted or proxied host.
NEXT_PUBLIC_POSTHOG_HOST=

# https://dashboard.openpanel.dev/ncdai/chanhdaicom/settings/clients
NEXT_PUBLIC_OPENPANEL_CLIENT_ID=
OPENPANEL_PROJECT_ID=
OPENPANEL_CLIENT_ID=
OPENPANEL_CLIENT_SECRET=

# https://openrouter.ai/keys
# Server-only; never expose this to the client. The chat widget degrades to a
# "chat is off" message when it is unset, so local development works without it.
OPENROUTER_API_KEY=

ADS_TXT=

# Overrides the chat widget's model. Unset in normal deployments; used by the
# red team scan so a few hundred generated turns do not spend the free daily
# allowance the live widget runs on.
CHAT_MODEL_OVERRIDE=

# https://cloud.langfuse.com > project settings > API keys
# Server-only. The chat widget's system prompt is versioned in Langfuse; when these
# are unset the repo copy is served, so local development and forks work without
# them. BASE_URL defaults to the EU cloud.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=
# Which label to serve. Defaults to production.
LANGFUSE_PROMPT_LABEL=
# Serves one exact version instead of a label: the red team gate pins the version
# under test with it, and locally it previews a version before it is promoted.
LANGFUSE_PROMPT_VERSION=
# CI only. Never set in Vercel: it turns a Langfuse outage into "chat is off".
# Makes a failed fetch an error instead of a fallback to the repo copy, so the red
# team gate cannot pass a version it never loaded.
LANGFUSE_PROMPT_STRICT=

# Langfuse webhook > signing secret. Verifies deliveries to /api/langfuse-webhook.
LANGFUSE_WEBHOOK_SECRET=
# https://github.com/settings/personal-access-tokens
# Fine-grained, this repository only, Actions: write and nothing else. Lets the
# webhook start the red team gate for a new prompt version. Not GITHUB_API_TOKEN.
GITHUB_DISPATCH_TOKEN=
